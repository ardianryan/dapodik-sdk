{
  "name": "@smansage/dapodik-sdk",
  "version": "1.0.0",
  "description": "Modern, fully-typed TypeScript/JavaScript SDK untuk WebService Dapodik Kemendikdasmen",
  "homepage": "https://www.instagram.com/smansagewithai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardianryan/dapodik-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ardianryan/dapodik-sdk/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dapodik",
    "dapodik-api",
    "dapodik-sdk",
    "kemendikdasmen",
    "kemendikbud",
    "webservice",
    "typescript",
    "api-client"
  ],
  "author": "Ryan Ardian",
  "contributors": [
    "SMA Negeri 1 Gedeg <https://www.instagram.com/smansagewithai/>"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
