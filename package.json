{
  "name": "@ardianryan/dapodik-sdk",
  "version": "1.2.0",
  "description": "Modern, fully-typed TypeScript/JavaScript SDK untuk WebService Dapodik Kemendikdasmen",
  "homepage": "https://github.com/ardianryan/dapodik-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardianryan/dapodik-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ardianryan/dapodik-sdk/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dapodik",
    "dapodik-api",
    "dapodik-sdk",
    "kemendikdasmen",
    "kemendikbud",
    "webservice",
    "typescript",
    "api-client"
  ],
  "author": "Ryan Ardian <inisaya@ardianryan.com>",
  "contributors": [
    "SMA Negeri 1 Gedeg <https://www.instagram.com/smansagewithai/>"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
